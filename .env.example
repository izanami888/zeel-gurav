# Supabase төслийн тохиргоо
# https://app.supabase.com/project/_/settings/api хаягаас авна уу
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# "Нууц зурвас" (нэрээ нууцалсан зурвас) — зөвхөн сервер талд ашиглагдана.
# service_role key-г хэзээ ч клиент рүү (NEXT_PUBLIC_) гаргаж болохгүй!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Сесс болон илгээгчийн хэшийг гарын үсэг зурах нууц түлхүүр (16+ тэмдэгт).
# Үүсгэх: openssl rand -base64 32
ZURVAS_SECRET=change-me-to-a-long-random-string

# Бэлэг (кофе) — QPay Merchant API v2 (https://developer.qpay.mn)
# Тохируулаагүй бол локал дээр туршилтын (mock) төлбөр ажиллана.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Sandbox турших бол: https://merchant-sandbox.qpay.mn/v2
QPAY_BASE_URL=https://merchant.qpay.mn/v2
# Сайтын нийтийн хаяг (QPay callback-д ашиглагдана)
NEXT_PUBLIC_SITE_URL=https://your-domain.mn
