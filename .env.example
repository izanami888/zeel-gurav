# Supabase төслийн тохиргоо
# https://app.supabase.com/project/_/settings/api хаягаас авна уу
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Зөвхөн сервер талд ашиглагдана (онлайн шатрын өрөөнд бичихэд).
# Хэзээ ч NEXT_PUBLIC_ угтвар бүү нэм, бусадтай бүү хуваалц.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
