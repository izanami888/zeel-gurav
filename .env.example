# Supabase төслийн тохиргоо
# https://app.supabase.com/project/_/settings/api хаягаас авна уу
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# "Нууц зурвас" (нэрээ нууцалсан зурвас) — зөвхөн сервер талд ашиглагдана.
# service_role key-г хэзээ ч клиент рүү (NEXT_PUBLIC_) гаргаж болохгүй!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Сесс болон илгээгчийн хэшийг гарын үсэг зурах нууц түлхүүр (16+ тэмдэгт).
# Үүсгэх: openssl rand -base64 32
ZURVAS_SECRET=change-me-to-a-long-random-string
